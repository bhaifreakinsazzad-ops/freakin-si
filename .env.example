# ── Engine NotREAL — Environment Variables ────────────────────────────────────
# Copy this to apps/backend/.env (backend) and apps/web/.env (frontend) as needed

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Supabase (required) ───────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# ── AI Providers ─────────────────────────────────────────────────────────────
# The AI router will use the FIRST configured provider automatically.
# Priority order: Groq → Google → OpenAI → Anthropic → Mistral → Together → DeepSeek → xAI → Perplexity
# Add at least ONE to enable live AI. Leave all blank for demo/preview mode.

# Groq — free tier, fast (recommended for MVP)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=AIza...

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Mistral
MISTRAL_API_KEY=...
MISTRAL_MODEL=mistral-small-latest

# Together AI
TOGETHER_API_KEY=...

# DeepSeek
DEEPSEEK_API_KEY=...

# xAI Grok
XAI_API_KEY=xai-...

# Perplexity
PERPLEXITY_API_KEY=pplx-...

# OpenRouter (fallback, supports 200+ models)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ── Web Search / Crawl (optional) ────────────────────────────────────────────
FIRECRAWL_API_KEY=fc-...

# ── Stripe (optional, for subscription payments) ──────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Manual Payment (Bangladesh — bKash/Nagad) ────────────────────────────────
PAYMENT_PHONE=01XXXXXXXXX

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://enginenotreal.com
VITE_API_URL=http://localhost:3001/api
VITE_PUBLIC_ACCESS=true

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@enginenotreal.com
ADMIN_EMAILS=admin@enginenotreal.com

# ── Subscription ──────────────────────────────────────────────────────────────
FREE_TRIAL_DAYS=7
