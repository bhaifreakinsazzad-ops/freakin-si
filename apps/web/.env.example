# preview: use same-domain Vercel API fallback by leaving API URLs empty or using /api
# hybrid/staging: point to Render backend, keep fallback enabled
# production: point to durable backend API
VITE_API_BASE_URL=/api
VITE_API_URL=/api
VITE_SERVICE_MODE=hybrid
VITE_PUBLIC_ACCESS=true
VITE_CLIENT_PREVIEW_MODE=true

# Serverless API durable persistence for Vercel functions.
# Do not expose service-role keys to the browser with a VITE_ prefix.
SUPABASE_PROJECT_ID=pcaturcbsepbtaqksqqm
SUPABASE_URL=https://pcaturcbsepbtaqksqqm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
