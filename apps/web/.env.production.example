# Client preview on Vercel, using same-domain fallback API.
VITE_API_BASE_URL=/api
VITE_API_URL=/api
VITE_SERVICE_MODE=hybrid
VITE_PUBLIC_ACCESS=true
VITE_CLIENT_PREVIEW_MODE=true

