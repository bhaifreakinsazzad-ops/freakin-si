NODE_ENV=production
PORT=3001
JWT_SECRET=change-this-secret
FRONTEND_URL=https://your-frontend-host
CLIENT_PREVIEW_MODE=true
ADMIN_EMAILS=demo@blacksheep.ai

# Durable persistence.
# If these are set, the backend uses Supabase/Postgres.
# If they are missing, the backend falls back to in-memory preview data.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_KEY=

# Optional provider keys
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=
