# ============================================================
# Engine NotREAL — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ── SERVER ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex')"
JWT_SECRET=change-this-to-a-64-char-random-hex-string

# ── SUPABASE (required for production persistence) ───────────
# 1. Create project at https://supabase.com
# 2. Run all migrations in apps/backend/migrations/ (001→004)
# 3. Go to Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-from-settings-api   # secret, never expose to frontend

# ── AI PROVIDERS (at least one for live AI) ──────────────────
# Groq — free tier, fast: https://console.groq.com
GROQ_API_KEY=gsk_...

# Other providers (optional)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_GENERATIVE_AI_API_KEY=AIza...
MISTRAL_API_KEY=...
TOGETHER_API_KEY=...
DEEPSEEK_API_KEY=...
XAI_API_KEY=...
PERPLEXITY_API_KEY=...

# ── ADMIN ────────────────────────────────────────────────────
# Comma-separated emails — these users get admin access
ADMIN_EMAILS=you@yourdomain.com

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com

# ── PAYMENT ──────────────────────────────────────────────────
# Stripe (optional — manual bKash/Nagad/Rocket flow works without it)
STRIPE_SECRET_KEY=sk_live_...
PAYMENT_PHONE=01778307704

# ── APP ──────────────────────────────────────────────────────
APP_NAME=Engine NotREAL
